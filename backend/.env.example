# FlowTrace Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── Etherscan API ─────────────────────────────────────────────────────────────
# Get a free key at: https://etherscan.io/apis
# Without this, the API still works but is limited to 1 req/5s (usable for demos).
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Network ───────────────────────────────────────────────────────────────────
# 'mainnet' for realistic data, 'sepolia' for testnet (sparse transactions).
# ⚠ Note: mainnet is read-only here — no funds are ever sent.
NETWORK=mainnet

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
